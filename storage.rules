rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /recordings/{allPaths=**} {
      // Authenticated users can read recordings
      allow read: if request.auth != null;
      // Only authenticated adults/parents (who have an email on their auth token) can upload or modify video files
      allow write: if request.auth != null && request.auth.token.email != null;
    }
  }
}
